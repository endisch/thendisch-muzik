generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ARTIST
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  googleId          String?   @unique
  email             String    @unique
  password          String?
  name              String?
  image             String?
  uploadCredits     Int       @default(0) // Default 0 for normal users
  songsListened     Int       @default(0)
  createdAt         DateTime  @default(now())
  
  // Sanatçı & Admin özellikleri
  role              Role      @default(USER)
  instagramUrl      String?
  spotifyUrl        String?
  youtubeUrl        String?
  artistApplication Boolean   @default(false)
  isVerifiedArtist  Boolean   @default(false)
  lastUploadDate    DateTime? // Günlük yükleme limiti kontrolü için

  songs             Song[]
  playHistory       PlayHistory[]
  votes             Vote[]
}

model Song {
  id          String   @id @default(cuid())
  title       String
  artist      String
  fileUrl     String
  coverUrl    String?
  youtubeUrl  String?  // Yeni eklendi
  lyricsLrc   String?  @db.Text
  durationSec Int
  categories  String[]
  genres      String[]
  status      SongStatus @default(QUEUED)
  uploadedBy  String
  uploader    User     @relation(fields: [uploadedBy], references: [id])
  votesCount  Int      @default(0)
  createdAt   DateTime @default(now())

  playHistory PlayHistory[]
  votes       Vote[]

  @@index([status, votesCount])
}

// Yeni: Her kullanıcının bir şarkıya sadece 1 oy verebilmesini sağlayan tablo
model Vote {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  song      Song     @relation(fields: [songId], references: [id])

  @@unique([userId, songId])
}

enum SongStatus {
  QUEUED
  PLAYING
  PLAYED
}

model NowPlaying {
  id        Int      @id @default(1)
  songId    String?
  startedAt DateTime?
}

model PlayHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  songId       String
  song         Song     @relation(fields: [songId], references: [id])
  completed    Boolean  @default(false)
  listenedAt   DateTime @default(now())

  @@index([userId])
}
